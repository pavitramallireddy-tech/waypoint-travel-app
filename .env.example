# Copy this file to .env.local and fill in your own keys.
# Never commit .env.local — it's already ignored by .gitignore.

# OpenWeather (https://openweathermap.org/api) — free tier is enough
VITE_OPENWEATHER_API_KEY=

# Pexels (https://www.pexels.com/api/) — free, generous rate limit
VITE_PEXELS_API_KEY=

# Google Gemini (https://ai.google.dev/) — free tier available
VITE_GEMINI_API_KEY=
